# Copy to .env and fill in:  cp .env.example .env

# Secret the MCP client (Claude CLI) must send in the X-API-Key header. Generate one: openssl rand -hex 24
MCP_API_KEY=change-me

# Address you reach this server on. Detail links in search results are built from it.
#   local / SSH tunnel:  http://localhost:8001
#   public VPS:          http://<vps-ip>:8001
PUBLIC_URL=http://localhost:8001

# Host port the server is published on (must match the port in PUBLIC_URL)
PORT=8001

# Optional: 2captcha.com API key, only used if Anna's Archive shows an image captcha. Leave empty to disable.
CAPTCHA_API_KEY=
